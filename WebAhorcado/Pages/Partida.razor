@page "/partida"
@implements IDisposable
@inject EstadoDelJuego Estado

<main class="partida contenido">
    <header class="encabezado">
        <a href="" data-testid="volver-inicio" class="btn btn-secundario">@T("Inicio")</a>
        <h1>@T("Ahorcado")</h1>
        <div class="chips">
            <span class="chip">@T("Jugador"): <strong data-testid="jugador">@Estado.Turnos.Actual</strong></span>
            <span class="chip">@T("Categoría"): <span data-testid="categoria-actual">@T(juego?.Categoria ?? "")</span></span>
            <span class="chip chip-tiempo">@T("Tiempo restante"): <span data-testid="tiempo-restante">@juego?.TiempoRestante</span></span>
        </div>
    </header>

    <div class="juego">
        <div class="dibujo">
            @{ var partes = juego?.PartesDelDibujo ?? 0; }
            <svg data-testid="dibujo" class="ahorcado" data-skin="@Estado.Skin" width="160" height="200" viewBox="0 0 160 200">
                <line x1="10" y1="190" x2="110" y2="190" />
                <line x1="40" y1="190" x2="40" y2="10" />
                <line x1="40" y1="10" x2="110" y2="10" />
                <line x1="110" y1="10" x2="110" y2="30" />
                @if (Estado.Skin == "robot")
                {
                    if (partes >= 1)
                    {
                        <rect data-testid="parte-1" x="96" y="30" width="28" height="28" rx="3" />
                        <rect class="ojo" x="101" y="38" width="6" height="6" />
                        <rect class="ojo" x="113" y="38" width="6" height="6" />
                    }
                    if (partes >= 2) { <rect data-testid="parte-2" x="95" y="62" width="30" height="55" rx="3" /> }
                    if (partes >= 3) { <rect data-testid="parte-3" x="80" y="66" width="10" height="36" rx="3" /> }
                    if (partes >= 4) { <rect data-testid="parte-4" x="130" y="66" width="10" height="36" rx="3" /> }
                    if (partes >= 5) { <rect data-testid="parte-5" x="97" y="120" width="11" height="38" rx="3" /> }
                    if (partes >= 6) { <rect data-testid="parte-6" x="112" y="120" width="11" height="38" rx="3" /> }
                }
                else
                {
                    if (partes >= 1) { <circle data-testid="parte-1" cx="110" cy="45" r="15" /> }
                    if (partes >= 2) { <line data-testid="parte-2" x1="110" y1="60" x2="110" y2="120" /> }
                    if (partes >= 3) { <line data-testid="parte-3" x1="110" y1="75" x2="85" y2="100" /> }
                    if (partes >= 4) { <line data-testid="parte-4" x1="110" y1="75" x2="135" y2="100" /> }
                    if (partes >= 5) { <line data-testid="parte-5" x1="110" y1="120" x2="90" y2="155" /> }
                    if (partes >= 6) { <line data-testid="parte-6" x1="110" y1="120" x2="130" y2="155" /> }
                }
            </svg>
        </div>

        <div class="panel">
            <p data-testid="palabra-oculta" class="palabra">@juego?.PalabraEnmascarada()</p>

            <div class="jugada">
                <input data-testid="letra-input" aria-label="Letra" maxlength="1" @bind="letra" @bind:event="oninput" @onkeydown="TeclaPresionada" disabled="@(juego?.Terminado == true)" />
                <button data-testid="letra-enviar" class="btn btn-primario" @onclick="EnviarLetra">@T("Adivinar")</button>
                <button data-testid="pista" class="btn btn-secundario" @onclick="PedirPista" disabled="@(juego?.PuedePedirPista != true)">@T("Pedir pista")</button>
            </div>

            <p data-testid="mensaje" class="mensaje">@T(juego?.Mensaje ?? "")</p>

            <div class="marcadores">
                <p class="marcador">@T("Errores") <span data-testid="errores">@juego?.Errores</span></p>
                <p class="marcador">@T("Puntaje") <span data-testid="puntaje">@juego?.Puntaje</span></p>
                <p class="marcador">@T("Resultado") <span data-testid="resultado">@T(juego?.Resultado ?? "")</span></p>
            </div>
        </div>
    </div>

    <footer class="acciones">
        <button data-testid="siguiente-partida" class="btn btn-secundario" @onclick="SiguientePartida">@T("Siguiente partida")</button>
    </footer>
</main>


@code {
    [SupplyParameterFromQuery(Name = "word")]    
    public string? Word { get; set; }

    [SupplyParameterFromQuery(Name = "tiempo")]
    public int? Tiempo { get; set; }

    private Ahorcado.Ahorcado? juego;
    private string letra = "";
    private readonly Ahorcado.SelectorDePalabras selector = new(cantidad => Random.Shared.Next(cantidad));

    protected override void OnParametersSet()
    {
        if (juego is not null) return;

        juego = Estado.Configuracion.CrearPartida(selector, Word);
        if (Tiempo > 0)
            juego.EstablecerLimite(Tiempo.Value);
    }

    private void EnviarLetra()
    {
        if (letra.Length == 1)
        {
            juego!.Adivinar(letra[0]);
            RegistrarSiTermino();
        }
        letra = "";
    }

    private void PedirPista()
    {
        juego!.PedirPista();
        RegistrarSiTermino();
    }

    private void RegistrarSiTermino()
    {
        if (juego!.Terminado)
            Estado.Historial.Registrar(Estado.Turnos.Actual, juego.Puntaje);
    }

    private void TeclaPresionada(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            EnviarLetra();
    }

    private System.Threading.Timer? reloj;

    protected override void OnInitialized()
    {
        reloj = new System.Threading.Timer(_ => InvokeAsync(() =>
        {
            if (juego is null || juego.Terminado) return;

            juego.PasarSegundo();
            RegistrarSiTermino();
            StateHasChanged();
        }), null, 1000, 1000);
    }


    private string T(string texto) => new Ahorcado.Traductor(Estado.Configuracion.Idioma).Traducir(texto);

    public void Dispose() => reloj?.Dispose();

    private void SiguientePartida()
    {
        Estado.Turnos.Pasar();
        juego = Estado.Configuracion.CrearPartida(selector, Word);
    }
}