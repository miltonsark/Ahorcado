@page "/partida"
@implements IDisposable
@inject EstadoDelJuego Estado

<h1>@T("Ahorcado")</h1>

<label>
    @T("Idioma"):
    <select data-testid="idioma" @onchange="CambiarIdioma">
        <option value="Espanol" selected>Español</option>
        <option value="Ingles">English</option>
    </select>
</label>

<button data-testid="config-predeterminada" @onclick="UsarConfiguracionPredeterminada">@T("Usar configuración predeterminada")</button>

<label>Nombre: <input data-testid="nombre-input" @bind="nombre" @bind:event="oninput" @bind:after="ActualizarJugadores" /></label>
<p>Jugador: <span data-testid="jugador">@Estado.Turnos.Actual</span></p>

<label>
    @T("Dificultad"):
    <select data-testid="dificultad" @onchange="CambiarDificultad">
        <option value="Facil">@T("Fácil")</option>
        <option value="Normal" selected>@T("Normal")</option>
        <option value="Dificil">@T("Difícil")</option>
    </select>
</label>

<label>
    @T("Categoría"):
    <select data-testid="categoria" @onchange="CambiarCategoria">
        <option value="" selected>@T("Sin categoría")</option>
        <option value="Animales">@T("Animales")</option>
        <option value="Frutas">@T("Frutas")</option>
        <option value="Colores">@T("Colores")</option>
    </select>
</label>

<p>@T("Categoría"): <span data-testid="categoria-actual">@T(Estado.Configuracion.Categoria)</span></p>

<label>
    @T("Tiempo"):
    <select data-testid="limite-tiempo" @onchange="CambiarLimite">
        <option value="0" selected>@T("Sin límite")</option>
        <option value="60">@T("60 segundos")</option>
        <option value="30">@T("30 segundos")</option>
    </select>
</label>

<label>
    @T("Skin"):
    <select data-testid="skin" @onchange="CambiarSkin">
        <option value="clasico" selected>@T("Clásico")</option>
        <option value="pizarra">@T("Pizarra")</option>
    </select>
</label>
<p>@T("Tiempo restante"): <span data-testid="tiempo-restante">@juego?.TiempoRestante</span></p>

@{ var partes = juego?.PartesDelDibujo ?? 0; }
<svg data-testid="dibujo" class="ahorcado" data-skin="@Estado.Skin" width="160" height="200" viewBox="0 0 160 200">
    <line x1="10" y1="190" x2="110" y2="190" />
    <line x1="40" y1="190" x2="40" y2="10" />
    <line x1="40" y1="10" x2="110" y2="10" />
    <line x1="110" y1="10" x2="110" y2="30" />
    @if (partes >= 1) { <circle data-testid="parte-1" cx="110" cy="45" r="15" /> }
    @if (partes >= 2) { <line data-testid="parte-2" x1="110" y1="60" x2="110" y2="120" /> }
    @if (partes >= 3) { <line data-testid="parte-3" x1="110" y1="75" x2="85" y2="100" /> }
    @if (partes >= 4) { <line data-testid="parte-4" x1="110" y1="75" x2="135" y2="100" /> }
    @if (partes >= 5) { <line data-testid="parte-5" x1="110" y1="120" x2="90" y2="155" /> }
    @if (partes >= 6) { <line data-testid="parte-6" x1="110" y1="120" x2="130" y2="155" /> }
</svg>

<p data-testid="palabra-oculta">@juego?.PalabraEnmascarada()</p>

<input data-testid="letra-input" maxlength="1" @bind="letra" @bind:event="oninput" @onkeydown="TeclaPresionada" disabled="@(juego?.Terminado == true)" />
<button data-testid="letra-enviar" @onclick="EnviarLetra">@T("Adivinar")</button>
<button data-testid="pista" @onclick="PedirPista" disabled="@(juego?.PuedePedirPista != true)">@T("Pedir pista")</button>
<button data-testid="siguiente-partida" @onclick="SiguientePartida">Siguiente partida</button>


<p>@T("Errores"): <span data-testid="errores">@juego?.Errores</span></p>
<p data-testid="mensaje">@T(juego?.Mensaje ?? "")</p>
<p data-testid="resultado">@T(juego?.Resultado ?? "")</p>
<p>@T("Puntaje"): <span data-testid="puntaje">@juego?.Puntaje</span></p>

<h2>@T("Historial")</h2>
<ul data-testid="historial">
    @foreach (var entrada in Estado.Historial.Entradas)
    {
        <li>@entrada</li>
    }
</ul>


@code {
    [SupplyParameterFromQuery(Name = "word")]    
    public string? Word { get; set; }

    [SupplyParameterFromQuery(Name = "tiempo")]
    public int? Tiempo { get; set; }

    private Ahorcado.Ahorcado? juego;
    private string letra = "";
    private string nombre = ""; 
    private readonly Ahorcado.SelectorDePalabras selector = new(cantidad => Random.Shared.Next(cantidad));

    protected override void OnParametersSet()
    {
        if (juego is not null) return;

        juego = Estado.Configuracion.CrearPartida(selector, Word);
        if (Tiempo > 0)
            juego.EstablecerLimite(Tiempo.Value);
    }

    private void EnviarLetra()
    {
        if (letra.Length == 1)
        {
            juego!.Adivinar(letra[0]);
            RegistrarSiTermino();
        }
        letra = "";
    }

    private void PedirPista()
    {
        juego!.PedirPista();
        RegistrarSiTermino();
    }

    private void RegistrarSiTermino()
    {
        if (juego!.Terminado)
            Estado.Historial.Registrar(Estado.Turnos.Actual, juego.Puntaje);
    }

    private void TeclaPresionada(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            EnviarLetra();
    }

    private void UsarConfiguracionPredeterminada()
    {
        juego = new Ahorcado.Ahorcado(Ahorcado.SelectorDePalabras.PalabraPorDefecto(Estado.Configuracion.Idioma));
    }

    private void CambiarDificultad(ChangeEventArgs e)
    {
        var dificultad = Enum.Parse<Ahorcado.Dificultad>(e.Value!.ToString()!);
        juego = new Ahorcado.Ahorcado(Word ?? "", dificultad);
    }

    private void CambiarCategoria(ChangeEventArgs e)
    {
        var elegida = e.Value!.ToString()!;
        if (elegida == "") return;
        Estado.Configuracion.Categoria = elegida;
        juego = new Ahorcado.Ahorcado(selector.Elegir(elegida, Estado.Configuracion.Idioma));
    }
    private System.Threading.Timer? reloj;

    protected override void OnInitialized()
    {
        reloj = new System.Threading.Timer(_ => InvokeAsync(() =>
        {
            if (juego is null || juego.Terminado) return;

            juego.PasarSegundo();
            RegistrarSiTermino();
            StateHasChanged();
        }), null, 1000, 1000);
    }

    private void CambiarLimite(ChangeEventArgs e)
    {
        var segundos = int.Parse(e.Value!.ToString()!);
        juego = new Ahorcado.Ahorcado(Word ?? "");
        if (segundos > 0)
            juego.EstablecerLimite(segundos);
    }

    private void CambiarSkin(ChangeEventArgs e) => Estado.Skin = e.Value!.ToString()!;


    private string T(string texto) => new Ahorcado.Traductor(Estado.Configuracion.Idioma).Traducir(texto);

    private void CambiarIdioma(ChangeEventArgs e)
    {
        Estado.Configuracion.Idioma = Enum.Parse<Ahorcado.Idioma>(e.Value!.ToString()!);
        juego = new Ahorcado.Ahorcado(Word ?? Ahorcado.SelectorDePalabras.PalabraPorDefecto(Estado.Configuracion.Idioma));
    }

    public void Dispose() => reloj?.Dispose();

    private void ActualizarJugadores() => Estado.Turnos = new Ahorcado.Turnos(nombre);

    private void SiguientePartida()
    {
        Estado.Turnos.Pasar();
        juego = new Ahorcado.Ahorcado(Word ?? "");
    }
}