@page "/configuracion"
@inject NavigationManager Nav
@inject EstadoDelJuego Estado

<main class="configuracion">
    <h1>Configuración</h1>

    <label>
        Categoría:
        <select data-testid="categoria" @bind="Estado.Configuracion.Categoria">
            <option value="" selected>Sin categoría</option>
            <option value="Animales">Animales</option>
            <option value="Frutas">Frutas</option>
            <option value="Colores">Colores</option>
        </select>
    </label>

    <label>
        Dificultad:
        <select data-testid="dificultad" @bind="Estado.Configuracion.Dificultad">
            <option value="Facil">Fácil</option>
            <option value="Normal" selected>Normal</option>
            <option value="Dificil">Difícil</option>
        </select>
    </label>

    <label>
        Idioma:
        <select data-testid="idioma" @bind="Estado.Configuracion.Idioma">
            <option value="Espanol" selected>Español</option>
            <option value="Ingles">English</option>
        </select>
    </label>

    <label>
        Tiempo:
        <select data-testid="limite-tiempo" @bind="Estado.Configuracion.Tiempo">
            <option value="0" selected>Sin límite</option>
            <option value="60">60 segundos</option>
            <option value="30">30 segundos</option>
        </select>
    </label>

    <label>
        Skin:
        <select data-testid="skin" @bind="Estado.Skin">
            <option value="clasico" selected>Clásico</option>
            <option value="pizarra">Pizarra</option>
        </select>
    </label>

    <fieldset>
        <legend>Jugadores</legend>
        <label>Jugador 1: <input data-testid="jugador-1" @bind="Estado.Jugadores[0]" /></label>
        <label>Jugador 2: <input data-testid="jugador-2" @bind="Estado.Jugadores[1]" /></label>
        <label>Jugador 3: <input data-testid="jugador-3" @bind="Estado.Jugadores[2]" /></label>
        <label>Jugador 4: <input data-testid="jugador-4" @bind="Estado.Jugadores[3]" /></label>
    </fieldset>

    <button data-testid="config-predeterminada">Usar configuración predeterminada</button>

    <button data-testid="guardar-configuracion" @onclick="Guardar">Guardar</button>
</main>

@code {
    private void Guardar()
    {
        Estado.Turnos = new Ahorcado.Turnos(string.Join(",", Estado.Jugadores.Where(nombre => nombre.Trim() != "")));
        Nav.NavigateTo("");
    }
}
