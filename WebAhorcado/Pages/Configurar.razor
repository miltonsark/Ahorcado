@page "/configuracion"
@inject NavigationManager Nav
@inject EstadoDelJuego Estado

<main class="configuracion">
    <h1>Configuración</h1>

    <label>
        Categoría:
        <select data-testid="categoria" @bind="Estado.Configuracion.Categoria">
            <option value="" selected>Sin categoría</option>
            <option value="Animales">Animales</option>
            <option value="Frutas">Frutas</option>
            <option value="Colores">Colores</option>
        </select>
    </label>

    <label>
        Dificultad:
        <select data-testid="dificultad" @bind="Estado.Configuracion.Dificultad">
            <option value="Facil">Fácil</option>
            <option value="Normal" selected>Normal</option>
            <option value="Dificil">Difícil</option>
        </select>
    </label>

    <button data-testid="guardar-configuracion" @onclick="Guardar">Guardar</button>
</main>

@code {
    private void Guardar() => Nav.NavigateTo("");
}
