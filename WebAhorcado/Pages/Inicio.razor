@page "/"
@inject EstadoDelJuego Estado

<main class="inicio">
    <h1>@T("Ahorcado")</h1>
    <nav>
        <a href="partida" data-testid="ir-partida" class="btn btn-primario">@T("Iniciar partida")</a>
        <a href="configuracion" data-testid="ir-configuracion" class="btn btn-secundario">@T("Configuración")</a>
        <a href="historial" data-testid="ir-historial" class="btn btn-secundario">@T("Historial y jugadores")</a>
    </nav>
</main>

@code {
    private string T(string texto) => new Ahorcado.Traductor(Estado.Configuracion.Idioma).Traducir(texto);
}
