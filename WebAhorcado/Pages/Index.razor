@page "/"
@implements IDisposable

<h1>Ahorcado</h1>

<button data-testid="config-predeterminada" @onclick="UsarConfiguracionPredeterminada">Usar configuración predeterminada</button>

<label>Nombre: <input data-testid="nombre-input" @bind="nombre" @bind:event="oninput" /></label>
<p>Jugador: <span data-testid="jugador">@(new Ahorcado.Jugador(nombre).Nombre)</span></p>

<label>
    Dificultad:
    <select data-testid="dificultad" @onchange="CambiarDificultad">
        <option value="Facil">Fácil</option>
        <option value="Normal" selected>Normal</option>
        <option value="Dificil">Difícil</option>
    </select>
</label>

<label>
    Categoría:
    <select data-testid="categoria" @onchange="CambiarCategoria">
        <option value="" selected>Sin categoría</option>
        <option value="Animales">Animales</option>
        <option value="Frutas">Frutas</option>
        <option value="Colores">Colores</option>
    </select>
</label>

<p>Categoría: <span data-testid="categoria-actual">@categoria</span></p>

<label>
    Tiempo:
    <select data-testid="limite-tiempo" @onchange="CambiarLimite">
        <option value="0" selected>Sin límite</option>
        <option value="60">60 segundos</option>
        <option value="30">30 segundos</option>
    </select>
</label>
<p>Tiempo restante: <span data-testid="tiempo-restante">@juego?.TiempoRestante</span></p>

<svg data-testid="dibujo" class="ahorcado" width="160" height="200" viewBox="0 0 160 200"></svg>

<p data-testid="palabra-oculta">@juego?.PalabraEnmascarada()</p>

<input data-testid="letra-input" maxlength="1" @bind="letra" @bind:event="oninput" @onkeydown="TeclaPresionada" disabled="@(juego?.Terminado == true)" />
<button data-testid="letra-enviar" @onclick="EnviarLetra">Adivinar</button>
<button data-testid="pista" @onclick="PedirPista" disabled="@(juego?.PuedePedirPista != true)">Pedir pista</button>

<p>Errores: <span data-testid="errores">@juego?.Errores</span></p>
<p data-testid="mensaje">@juego?.Mensaje</p>
<p data-testid="resultado">@juego?.Resultado</p>
<p>Puntaje: <span data-testid="puntaje">@juego?.Puntaje</span></p>

<h2>Historial</h2>
<ul data-testid="historial">
    @foreach (var entrada in historial.Entradas)
    {
        <li>@entrada</li>
    }
</ul>


@code {
    [SupplyParameterFromQuery(Name = "word")]    
    public string? Word { get; set; }

    [SupplyParameterFromQuery(Name = "tiempo")]
    public int? Tiempo { get; set; }

    private Ahorcado.Ahorcado? juego;
    private string letra = "";
    private string nombre = ""; 
    private string categoria = "";
    private readonly Ahorcado.Historial historial = new();
    private readonly Ahorcado.SelectorDePalabras selector = new(cantidad => Random.Shared.Next(cantidad));

    protected override void OnParametersSet()
    {
        if (juego is not null) return;

        juego = new Ahorcado.Ahorcado(Word ?? "");
        if (Tiempo > 0)
            juego.EstablecerLimite(Tiempo.Value);
    }

    private void EnviarLetra()
    {
        if (letra.Length == 1)
        {
            juego!.Adivinar(letra[0]);
            RegistrarSiTermino();
        }
        letra = "";
    }

    private void PedirPista()
    {
        juego!.PedirPista();
        RegistrarSiTermino();
    }

    private void RegistrarSiTermino()
    {
        if (juego!.Terminado)
            historial.Registrar(new Ahorcado.Jugador(nombre).Nombre, juego.Puntaje);
    }

    private void TeclaPresionada(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            EnviarLetra();
    }

    private void UsarConfiguracionPredeterminada()
    {
        juego = new Ahorcado.Ahorcado("");
    }

    private void CambiarDificultad(ChangeEventArgs e)
    {
        var dificultad = Enum.Parse<Ahorcado.Dificultad>(e.Value!.ToString()!);
        juego = new Ahorcado.Ahorcado(Word ?? "", dificultad);
    }

    private void CambiarCategoria(ChangeEventArgs e)
    {
        var elegida = e.Value!.ToString()!;
        if (elegida == "") return;
        categoria = elegida;
        juego = new Ahorcado.Ahorcado(selector.Elegir(elegida));
    }
    private System.Threading.Timer? reloj;

    protected override void OnInitialized()
    {
        reloj = new System.Threading.Timer(_ => InvokeAsync(() =>
        {
            if (juego is null || juego.Terminado) return;

            juego.PasarSegundo();
            RegistrarSiTermino();
            StateHasChanged();
        }), null, 1000, 1000);
    }

    private void CambiarLimite(ChangeEventArgs e)
    {
        var segundos = int.Parse(e.Value!.ToString()!);
        juego = new Ahorcado.Ahorcado(Word ?? "");
        if (segundos > 0)
            juego.EstablecerLimite(segundos);
    }

    public void Dispose() => reloj?.Dispose();
}