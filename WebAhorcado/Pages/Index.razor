@page "/"

<h1>Ahorcado</h1>

<button data-testid="config-predeterminada" @onclick="UsarConfiguracionPredeterminada">Usar configuración predeterminada</button>

<label>Nombre: <input data-testid="nombre-input" @bind="nombre" @bind:event="oninput" /></label>
<p>Jugador: <span data-testid="jugador">@(new Ahorcado.Jugador(nombre).Nombre)</span></p>

<label>
    Dificultad:
    <select data-testid="dificultad">
        <option value="Facil">Fácil</option>
        <option value="Normal" selected>Normal</option>
        <option value="Dificil">Difícil</option>
    </select>
</label>

<p data-testid="palabra-oculta">@juego?.PalabraEnmascarada()</p>

<input data-testid="letra-input" maxlength="1" @bind="letra" @bind:event="oninput" @onkeydown="TeclaPresionada" disabled="@(juego?.Terminado == true)" />
<button data-testid="letra-enviar" @onclick="EnviarLetra">Adivinar</button>
<button data-testid="pista" @onclick="() => juego!.PedirPista()" disabled="@(juego?.PuedePedirPista != true)">Pedir pista</button>

<p>Errores: <span data-testid="errores">@juego?.Errores</span></p>
<p data-testid="mensaje">@juego?.Mensaje</p>
<p data-testid="resultado">@juego?.Resultado</p>
<p>Puntaje: <span data-testid="puntaje">@juego?.Puntaje</span></p>


@code {
    [SupplyParameterFromQuery(Name = "word")]
    public string? Word { get; set; }

    private Ahorcado.Ahorcado? juego;
    private string letra = "";
    private string nombre = ""; 

    protected override void OnParametersSet()
    {
        juego ??= new Ahorcado.Ahorcado(Word ?? "");
    }

    private void EnviarLetra()
    {
        if (letra.Length == 1)
            juego!.Adivinar(letra[0]);
        letra = "";
    }

    private void TeclaPresionada(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            EnviarLetra();
    }

    private void UsarConfiguracionPredeterminada()
    {
        juego = new Ahorcado.Ahorcado("");
    }
}