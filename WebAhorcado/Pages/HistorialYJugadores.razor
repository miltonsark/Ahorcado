@page "/historial"
@inject EstadoDelJuego Estado

<main class="historial">
    <h1>Historial y jugadores</h1>

    <h2>Orden de turnos</h2>
    <ol data-testid="jugadores"></ol>

    <h2>Últimas partidas</h2>
    <ul data-testid="historial">
        @foreach (var entrada in Estado.Historial.Entradas)
        {
            <li>@entrada</li>
        }
    </ul>
</main>
